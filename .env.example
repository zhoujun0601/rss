# Telegram bot token
BotToken=your_bot_token_here

# Telegram administrator user ID; 0 allows all users
ADMINIDS=0

# RSS check interval in seconds
Cycletime=300

# Enable debug logs
Debug=false

# Optional HTTP/HTTPS proxy URL
ProxyURL=

# Optional push notification URL prefix
Pushinfo=

# IANA time zone used for displayed timestamps and daily statistics
TZ=Asia/Shanghai

